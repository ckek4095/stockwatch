# This file is a template. The application reads environment variables, not .env files.
TELEGRAM_BOT_TOKEN=replace_with_token_from_BotFather
FINNHUB_API_KEY=replace_with_your_finnhub_api_key
DATABASE_PATH=./data/stockwatch-us.sqlite3
# Empty = all users. For a private test put your numeric Telegram user ID here.
ALLOWED_USER_IDS=
MARKET_CACHE_SECONDS=60
MARKET_REQUESTS_PER_MINUTE=45
LOG_LEVEL=INFO
